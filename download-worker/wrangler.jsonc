{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hudalibrary-download-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "download.hudalibrary.com",
      "custom_domain": true
    }
  ]
}
